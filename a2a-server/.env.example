# Porta em que o servidor A2A escuta.
PORT=41241

# URL pública pela qual este agente será alcançado (usada no Agent Card).
# Ex.: https://tester-agent.suaempresa.com
AGENT_BASE_URL=http://localhost:41241

# Chave da API da Anthropic usada para executar o raciocínio do agente.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado para o agente de testes.
ANTHROPIC_MODEL=claude-sonnet-5

# Token(s) Bearer aceitos para autenticar chamadores A2A (separados por vírgula).
# Gere algo forte, ex.: `openssl rand -hex 32`.
A2A_BEARER_TOKENS=troque-por-um-token-forte-e-secreto

# Diretório de trabalho onde o agente pode ler/escrever/rodar comandos (Bash).
# Mantenha isolado — nunca aponte para algo fora do repositório-alvo.
WORKSPACE_DIR=../
