# Porta em que o servidor A2A escuta.
PORT=41241

# URL pública pela qual este agente será alcançado (usada no Agent Card).
# Ex.: https://tester-agent.suaempresa.com
AGENT_BASE_URL=http://localhost:41241

# Qual provider roda o raciocínio do agente:
# - "anthropic" (padrão): API da Anthropic na nuvem, cobrada por token.
# - "ollama": modelo local via Ollama, sem custo por token (requer
#   `ollama serve` rodando e um modelo com suporte a tool calling já
#   baixado, ex.: `ollama pull llama3.1`).
MODEL_PROVIDER=anthropic

# --- usado apenas quando MODEL_PROVIDER=anthropic ---

# Chave da API da Anthropic usada para executar o raciocínio do agente.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo usado para o agente de testes.
ANTHROPIC_MODEL=claude-sonnet-5

# --- usado apenas quando MODEL_PROVIDER=ollama ---

# URL do servidor Ollama local.
OLLAMA_BASE_URL=http://localhost:11434

# Modelo local a usar — precisa suportar tool calling.
# Opções testadas na comunidade: llama3.1, qwen2.5, mistral-nemo.
OLLAMA_MODEL=llama3.1

# Token(s) Bearer aceitos para autenticar chamadores A2A (separados por vírgula).
# Gere algo forte, ex.: `openssl rand -hex 32`.
A2A_BEARER_TOKENS=troque-por-um-token-forte-e-secreto

# Diretório de trabalho onde o agente pode ler/escrever/rodar comandos (Bash).
# Mantenha isolado — nunca aponte para algo fora do repositório-alvo.
WORKSPACE_DIR=../
